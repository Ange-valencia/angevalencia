# AngeValencia — configuration backend (copier vers .env et adapter)

APP_NAME=AngeValencia API
DEBUG=true
API_PREFIX=/api

# Base de données : sqlite en développement, postgresql en production.
DATABASE_URL=sqlite:///./angevalencia.db
# DATABASE_URL=postgresql+psycopg2://ange_eudes:motdepasse@localhost:5432/angevalencia

SECRET_KEY=a-changer-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=43200

# Délai affiché sur les fiches produits / avant commande (D3)
DEFAULT_DELIVERY_DELAY=~2 mois

# Règle retours (D2) : jours de garde du colis en compagnie de transport
COLLECTION_GRACE_DAYS=14

# Compte administrateur créé au premier lancement (scripts/seed_db.py)
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=AngeValencia